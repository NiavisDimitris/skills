{
  "body": { "selector": "body", "props": ["font-family", "color", "background-color"], "limit": 1 },
  "topbar": { "selector": "[data-testid=topbar]", "props": ["background-color", "height", "border-bottom-color"], "limit": 1 },
  "stepper": { "selector": "[data-component=Stepper]", "props": ["gap", "font-size"], "limit": 1 },
  "stepCurrent": { "selector": "[data-component=Stepper] [aria-current=step]", "props": ["color", "font-weight"], "limit": 1 },
  "pageTitle": { "selector": "h1", "props": ["font-size", "font-weight", "line-height", "color"], "limit": 1 },
  "sectionTitle": { "selector": "h2", "props": ["font-size", "font-weight", "line-height", "color"], "limit": 4 },
  "card": { "selector": "[data-component=Card]", "props": ["background-color", "border-radius", "padding-top", "padding-left", "box-shadow"], "limit": 3 },
  "lineItem": { "selector": "[data-testid=line-item]", "props": ["padding-top", "padding-bottom", "column-gap", "border-bottom-color"], "limit": 3 },
  "thumb": { "selector": "[data-testid=line-item-thumb]", "props": ["border-radius", "width", "height"], "limit": 3 },
  "stockBadge": { "selector": "[data-testid=stock-badge]", "props": ["background-color", "color", "border-radius", "font-size", "font-weight", "padding-left"], "limit": 3 },
  "summaryRow": { "selector": "[data-testid=summary-row]", "props": ["font-size", "color"], "limit": 3 },
  "summaryTotal": { "selector": "[data-testid=summary-total]", "props": ["font-size", "font-weight", "color"], "limit": 1 },
  "primaryCta": { "selector": "[data-testid=primary-cta]", "props": ["background-color", "color", "border-radius", "height", "padding-left", "font-size", "font-weight"], "limit": 2 },
  "secondaryCta": { "selector": "[data-testid=secondary-cta]", "props": ["background-color", "color", "border-radius", "height", "border-top-color"], "limit": 2 },
  "fieldLabel": { "selector": "[data-testid=field-label]", "props": ["font-size", "font-weight", "color"], "limit": 6 },
  "fieldControl": { "selector": "[data-testid=field-control]", "props": ["height", "border-top-color", "border-radius", "padding-left", "font-size", "background-color"], "limit": 6 },
  "countrySelect": { "selector": "[data-testid=country]", "props": ["height", "border-top-color", "border-radius", "padding-left", "background-color"], "limit": 1 },
  "deliveryOption": { "selector": "[data-testid=delivery-option]", "props": ["border-top-color", "border-radius", "padding-top", "background-color"], "limit": 2 },
  "alert": { "selector": "[data-component=Alert]", "props": ["background-color", "color", "border-radius", "padding-top"], "limit": 1 },
  "alertTitle": { "selector": "[data-component=Alert] strong", "props": ["font-weight", "color"], "limit": 1 },
  "alertAction": { "selector": "[data-testid=alert-action]", "props": ["font-size", "height"], "limit": 1 },
  "secureNote": { "selector": "[data-testid=secure-note]", "props": ["font-size", "color"], "limit": 1 },
  "reviewBlock": { "selector": "[data-testid=review-block]", "props": ["padding-top", "border-bottom-color"], "limit": 3 },
  "reviewItems": { "selector": "[data-testid=review-items]", "props": ["padding-top", "background-color", "border-radius"], "limit": 1 },
  "promoRow": { "selector": "[data-testid=promo-row]", "props": ["color", "font-size"], "limit": 1 },
  "editLink": { "selector": "[data-testid=edit-link]", "props": ["color", "font-weight", "font-size"], "limit": 3 },
  "emptyState": { "selector": "[data-component=EmptyState]", "props": ["padding-top", "text-align"], "limit": 1 },
  "confirmIcon": { "selector": "[data-testid=confirm-icon]", "props": ["width", "height", "background-color"], "limit": 1 },
  "orderNumber": { "selector": "[data-testid=order-number]", "props": ["font-weight", "color"], "limit": 1 },
  "toast": { "selector": "[data-component=Toast]", "props": ["background-color", "color", "border-radius"], "limit": 1 }
}
