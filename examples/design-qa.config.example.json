{
  "app": {
    "baseUrl": "http://localhost:3000",
    "start": "npm run dev",
    "readyUrl": "/",
    "auth": { "type": "none", "envPrefix": "DESIGN_QA_APP", "login": null, "signedInSelector": "[data-testid=app-nav]", "storageState": "~/.design-qa/sessions/acme-web-localhost-3000.json" },
    "headers": {},
    "preCapture": {
      "localStorage": { "acme:promo-banner-dismissed": "1" },
      "hide": ["[data-testid=chat-launcher]"],
      "click": ["[data-testid=cookie-notice] button[aria-label=Close]"]
    }
  },
  "surfaces": {
    "orders": {
      "route": "/orders",
      "fixture": "rich-orders",
      "figma": { "fileKey": "AbCdEfGhIjKlMnOp", "nodeId": "12:345" },
      "preCapture": { "remove": ["[data-testid=whats-new-ribbon]"] },
      "states": {
        "with-data": { "fixture": "rich-orders" },
        "empty":     { "mock": { "urlPattern": "**/api/orders*", "status": 200, "body": { "items": [] } } },
        "loading":   { "mock": { "urlPattern": "**/api/orders*", "delayMs": 60000 } },
        "error":     { "mock": { "urlPattern": "**/api/orders*", "status": 500, "body": { "error": "boom" } } },
        "hover":     { "action": "hover", "selector": "[data-testid=order-row]:first-child" },
        "selected":  { "action": "click", "selector": "[data-testid=order-row]:first-child" },
        "focus":     { "action": "keyboard", "keys": "Tab Tab Tab" }
      }
    },
    "checkout": {
      "route": "/checkout",
      "fixture": "rich-cart",
      "prototype": "https://acme-checkout.framer.website",
      "screens": {
        "cart":         { "figma": null, "prototype": "https://acme-checkout.framer.website/cart", "route": "/checkout/cart" },
        "payment":      { "figma": null, "prototype": "https://acme-checkout.framer.website/payment", "route": "/checkout/payment" },
        "confirmation": { "figma": null, "prototype": "https://acme-checkout.framer.website/done", "route": "/checkout/done" }
      },
      "states": {
        "with-data": { "fixture": "rich-cart" },
        "hover":     { "action": "hover", "selector": "[data-testid=cart-item]:first-child", "settleMs": 300 }
      }
    },
    "onboarding": {
      "route": "/welcome",
      "figma": { "fileKey": "AbCdEfGhIjKlMnOp", "nodeId": "40:1" },
      "screens": {
        "welcome": { "figma": "https://www.figma.com/design/AbCdEfGhIjKlMnOp/Acme?node-id=40-2", "prototype": null, "route": "/welcome" },
        "profile": { "figma": "https://www.figma.com/design/AbCdEfGhIjKlMnOp/Acme?node-id=40-3", "prototype": null, "route": "/welcome/profile" }
      }
    }
  },
  "designSystem": {
    "name": "Acme DS",
    "figmaLibrary": "https://www.figma.com/design/ZyXwVuTsRqPoNmLk/Acme-DS-Library",
    "componentCatalog": "design-qa/components.json",
    "tokenMap": "design-qa/token-map.md",
    "knownDrifts": "design-qa/known-drifts.md",
    "designRules": "design.md",
    "tokens": ["design-qa/tokens.json"],
    "libraries": [
      { "name": "Acme DS", "kind": "design-system", "selector": "[data-ds-component]", "package": "@acme/ds" },
      { "name": "Mui", "kind": "third-party", "classPrefix": "Mui", "package": "@mui/material" },
      { "name": "Legacy UI", "kind": "legacy", "classPrefix": "legacy-", "package": "@acme/legacy-ui" }
    ]
  },
  "tolerances": { "px": 1, "colorDeltaE": 1.5, "pixelDiff": { "pass": 1, "review": 5 } },
  "commands": { "test": "npm test", "lint": [], "cwd": "." },
  "report": {
    "outDir": "qa-reports",
    "commit": false,
    "topN": 5,
    "embedImages": true,
    "ranking": {
      "severity": { "BLOCKER": 3, "WARNING": 2, "DS_CANDIDATE": 1 },
      "ledger": { "structure": 3, "component": 3, "state": 3, "style": 2, "behavior": 2, "motion": 2 }
    }
  },
  "ticket": { "provider": "jira", "baseUrl": "https://acme.atlassian.net", "writeBack": false, "trustPreviewUrl": false },
  "figma": { "access": ["mcp", "rest"] },
  "capture": { "driver": "script", "reducedMotion": false, "maxViewportHeight": 1440 }
}
